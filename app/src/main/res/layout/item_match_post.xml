<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="14dp"
    app:cardElevation="3dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ẢNH SÂN CẦU LÔNG -->
        <ImageView
            android:id="@+id/ivCourtPost"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:scaleType="centerCrop"
            android:src="@drawable/anhsantest" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_item_court_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Sân Cầu Lông Cầu Giấy"
                    android:textColor="#0F172A"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_item_price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="40.000 VNĐ"
                    android:textColor="#16A34A"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_item_time_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="🕒 16:00 - 18:00 | 11/09/2026"
                android:textColor="#475569"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tv_item_level"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Trình độ: Giao lưu vui vẻ"
                android:textColor="#64748B"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tv_item_players"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Số người: 1/4"
                android:textColor="#0284C7"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_item_author"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Người đăng: Đỗ Hùng Dũng"
                    android:textColor="#94A3B8"
                    android:textSize="12sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_item_action"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:backgroundTint="#16A34A"
                    android:text="THAM GIA"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:cornerRadius="8dp" />
                <LinearLayout
                    android:id="@+id/layout_admin_actions"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <!-- Nút Duyệt bài -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_admin_approve"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:backgroundTint="#16A34A"
                        android:text="Duyệt bài"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:paddingHorizontal="10dp"
                        android:layout_marginEnd="6dp"
                        app:cornerRadius="8dp" />

                    <!-- Nút Xóa bài -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_admin_delete"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:backgroundTint="#DC2626"
                        android:text="Xóa bài"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:paddingHorizontal="10dp"
                        app:cornerRadius="8dp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>