<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Tiêu đề trang -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="QUẢN LÝ CỤM SÂN"
        android:textColor="#0F172A"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Thêm sân con mới vào hệ thống dữ liệu"
        android:textColor="#64748B"
        android:textSize="14sp"
        android:layout_marginBottom="32dp"/>

    <!-- Ô nhập Mã cụm sân -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Mã cụm sân"
        android:textColor="#334155"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <EditText
        android:id="@+id/etComplexId"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@android:drawable/edit_text"
        android:hint="VD: CUM_CAU_GIAY_01"
        android:paddingHorizontal="12dp"
        android:layout_marginBottom="20dp"
        android:inputType="text"/>

    <!-- Ô nhập Tên sân con -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tên sân con"
        android:textColor="#334155"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <EditText
        android:id="@+id/etCourtName"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@android:drawable/edit_text"
        android:hint="VD: Sân số 1 (Thảm VIP)"
        android:paddingHorizontal="12dp"
        android:layout_marginBottom="32dp"
        android:inputType="text"/>

    <!-- Nút xác nhận thêm sân -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAddCourt"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="THÊM SÂN MỚI"
        android:textSize="16sp"
        android:textStyle="bold"
        app:backgroundTint="#16A34A"
        app:cornerRadius="12dp" />

</LinearLayout>