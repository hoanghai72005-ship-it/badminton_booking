<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Tiêu đề trang -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="QUẢN LÝ KHUNG GIỜ"
        android:textColor="#0F172A"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Chủ động đóng/mở các ca đặt sân"
        android:textColor="#64748B"
        android:textSize="14sp"
        android:layout_marginBottom="32dp"/>

    <!-- Ô nhập Mã sân con -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Mã sân con"
        android:textColor="#334155"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <EditText
        android:id="@+id/etSubCourtId"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@android:drawable/edit_text"
        android:hint="VD: SAN_SO_1"
        android:paddingHorizontal="12dp"
        android:layout_marginBottom="20dp"
        android:inputType="text"/>

    <!-- Ô nhập Khung giờ -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Khung giờ"
        android:textColor="#334155"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <EditText
        android:id="@+id/etTimeSlot"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@android:drawable/edit_text"
        android:hint="VD: 18:00 - 19:00"
        android:paddingHorizontal="12dp"
        android:layout_marginBottom="24dp"
        android:inputType="text"/>

    <!-- Công tắc Khóa/Mở -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp"
        app:strokeColor="#E2E8F0"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Khóa khung giờ này"
                    android:textColor="#1E293B"
                    android:textSize="16sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Khách sẽ không thể đặt lịch vào ca này"
                    android:textColor="#64748B"
                    android:textSize="12sp"/>
            </LinearLayout>

            <Switch
                android:id="@+id/switchLockStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:theme="@style/Theme.AppCompat.Light"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Nút Cập nhật -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnUpdateStatus"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="CẬP NHẬT TRẠNG THÁI"
        android:textSize="16sp"
        android:textStyle="bold"
        app:backgroundTint="#F59E0B"
        app:cornerRadius="12dp" />

</LinearLayout>